# ── WDK Chain Providers ────────────────────────────────────────────────────────
# Refer to https://docs.wdk.tether.io/ for instructions on how to obtain these values.
# All of these are optional in the sense that the app will still boot without
# them — the network(s) they configure just won't be usable until they're set.

# Bitcoin — a Blockbook-compatible HTTP endpoint. Used for balance lookups,
# address derivation, and broadcasting BTC transactions.
EXPO_PUBLIC_BTC_PROVIDER=https://your-blockbook-instance.example.com

# EVM — a standard JSON-RPC endpoint (Infura, Alchemy, your own node, etc.)
# for the EVM network(s) this app is configured for.
EXPO_PUBLIC_EVM_PROVIDER=https://mainnet.infura.io/v3/YOUR_API_KEY

# EVM account abstraction (ERC-4337) — the bundler submits UserOperations on
# behalf of the wallet; the paymaster is what sponsors gas so the person
# doesn't need native ETH to transact. Both are required together for
# gasless EVM sends — a bundler without a paymaster will still require the
# wallet to pay its own gas.
EXPO_PUBLIC_EVM_BUNDLER_URL=https://your-bundler.example.com
EXPO_PUBLIC_EVM_PAYMASTER_URL=https://your-paymaster.example.com

# Tron — a standard TronGrid-compatible HTTP endpoint for balance lookups
# and broadcasting.
EXPO_PUBLIC_TRON_PROVIDER=https://api.trongrid.io

# Tron GasFree — an optional gas-sponsorship relay (gasfree.io) that lets
# the person send TRC-20 tokens without holding TRX for fees. Only needed if
# you want gasless Tron sends; omit all three GasFree variables to fall back
# to normal (fee-paying) Tron transactions.
EXPO_PUBLIC_TRON_GASFREE_PROVIDER=https://open.gasfree.io/tron
EXPO_PUBLIC_TRON_GASFREE_API_KEY=your-api-key
EXPO_PUBLIC_TRON_GASFREE_API_SECRET=your-api-secret


# ── Cloud Backup — iOS CloudKit ───────────────────────────────────────────────
# See docs/CLOUD_BACKUP.md for the full step-by-step (Apple Developer Portal
# setup, CloudKit schema, API token generation). None of these are required
# for the app to run — only for the iCloud backup option to work.

# The CloudKit container identifier you created in Apple Developer Portal.
# Format: iCloud.<your-bundle-id>
EXPO_PUBLIC_CLOUDKIT_CONTAINER_ID=your_cloudkit_container_id

# API token from icloud.developer.apple.com/dashboard → API Tokens.
# Type: "User authentication token (Web Services)".
# The token's "Sign in Callback" MUST be set to "URL Redirect" (not "Post
# Message") — Post Message is for browser popups and silently doesn't work
# with this app's WebView-based sign-in.
EXPO_PUBLIC_CLOUDKIT_API_TOKEN=your_cloudkit_api_token

# Any URL you choose — it does NOT need to be a real, reachable page, since
# this app intercepts the redirect before it ever actually loads. It DOES
# need to match, character for character, the "Sign in Callback" URL
# Redirect you registered for the API token above.
EXPO_PUBLIC_CLOUDKIT_CALLBACK_URL=your_cloudkit_callback_url

# ── Cloud Backup — Android Google Drive ───────────────────────────────────────
# See docs/CLOUD_BACKUP.md for the full step-by-step (Google Cloud Console
# project, OAuth clients, Drive API, consent screen scope). Like the CloudKit
# section above, these are only needed for the Google Drive backup option.

# Web Application OAuth Client ID from Google Cloud Console → Credentials.
# Must be the "Web client" type — NOT the Android client (that one only
# needs to exist in the console to register your SHA-1; its ID is never
# referenced in code). This value is project-scoped, not app-scoped, so the
# same Web Client ID can be reused across multiple apps in the same Google
# Cloud project.
#
# The value below is a PUBLISHED DEMO web client — copy it as-is and Google
# Drive backup works out of the box for local development. DEMO ONLY: do
# not ship this in a production build; set up your own client via
# docs/CLOUD_BACKUP.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=518914426511-um41gv98teak4u327nablql8bpb4vonb.apps.googleusercontent.com

# iOS OAuth Client ID — a SEPARATE credential from the Web client above and
# from any Android client (bound to your iOS bundle identifier, not a
# SHA-1). This is only needed because this app lets a person choose Google
# Drive on iOS too, not just Android — an app that only ever runs Google
# Sign-In on Android wouldn't need this at all. Also requires the reversed
# client ID to be registered as a URL scheme in app.json's
# @react-native-google-signin/google-signin plugin config — see
# docs/CLOUD_BACKUP.md section 3, or Google Sign-In fails silently on iOS
# with no useful error.
#
# The value below pairs with the demo Web client above — same DEMO ONLY
# caveat applies.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=518914426511-c46v1j9olhu5trra830bfo13cdj3ge4h.apps.googleusercontent.com


